08001618 <RTC_Init>:
static uint8_t BcdToDec(uint8_t val) {
    return (uint8_t)( (val / 16 * 10) + (val % 16) );
}

void RTC_Init(I2C_HandleTypeDef *hi2c) {
    rtc_i2c = hi2c;
